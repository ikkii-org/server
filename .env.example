PORT=3000
NODE_ENV=development

# Local development (docker-compose)
DATABASE_URL=postgres://postgres:postgres@db:5432/ikki

# Production (NeonDB) - uncomment and use your connection string
# DATABASE_URL=postgres://user:password@your-neon-host.neon.tech/ikki?sslmode=require

JWT_SECRET=your-jwt-secret-at-least-32-characters
COOKIE_SECRET=your-cookie-secret-at-least-32-characters
JWT_EXPIRES_IN=1h

# ── Game Integrations ────────────────────────────────────────────────────────
# Clash Royale API token from developer.clashroyale.com
CLASH_ROYALE_TOKEN=your-clash-royale-api-token

# Chess.com PubAPI User-Agent (must contain contact info per their TOS)
# Example: ikki/1.0 (+https://ikkii.gg; contact@ikkii.gg)
CHESS_COM_USER_AGENT=ikki/1.0 (+https://your-domain.com; your@email.com)
